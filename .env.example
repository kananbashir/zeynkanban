# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The database created in the hosting panel. Either fill in these four...
DB_HOST=localhost
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password
# ...or one address instead:  DATABASE_URL=mysql://user:password@localhost:3306/database

# A long random secret used to protect access codes and sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
